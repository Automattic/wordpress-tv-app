# --- build stage: compile + assemble a runnable distribution ----------------
FROM gradle:8.10-jdk21 AS build
WORKDIR /home/gradle/src
COPY --chown=gradle:gradle . .
RUN gradle --no-daemon clean installDist

# --- run stage: just a JRE + the built app ----------------------------------
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /home/gradle/src/build/install/broker/ ./
EXPOSE 8080
ENV PORT=8080
# `broker` launch script is generated by the Gradle `application` plugin.
ENTRYPOINT ["./bin/broker"]
