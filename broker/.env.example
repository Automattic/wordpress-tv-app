# --- WordPress.com OAuth app (https://developer.wordpress.com/apps/) -------
# Do NOT reuse another app's client_id; register a dedicated one for the broker.
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=

# --- Where this broker is reachable ----------------------------------------
# Public HTTPS base URL the phone's browser AND WordPress.com must be able to
# reach. For local testing against REAL WP.com you need a tunnel (cloudflared /
# ngrok) terminating HTTPS in front of this container — see README.
PUBLIC_BASE_URL=https://your-broker.example

# Must EXACTLY match the redirect_uri registered on the WP.com app.
# Leave blank to default to "$PUBLIC_BASE_URL/callback".
REDIRECT_URI=

# --- Optional --------------------------------------------------------------
# WPCOM_SCOPE=
# SESSION_TTL_SECONDS=300
# PORT=8080
