# --- WordPress.com OAuth apps (https://developer.wordpress.com/apps/) ------
# Register TWO dedicated apps; don't reuse another app's client_id. All four
# values are required.
# 1) Identity app — phase 1 (scope=auth, /me, /internal/automattician).
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
# 2) a8c.tv app — phase 2 (scope=posts videos, blog=a8ctv.wordpress.com).
#    MUST be a SEPARATE app from the identity one (same app + same user 500s).
WPCOM_A8C_CLIENT_ID=
WPCOM_A8C_CLIENT_SECRET=

# --- Where this broker is reachable (required) -----------------------------
# Public HTTPS base URL the phone's browser AND WordPress.com must be able to
# reach. For local testing against REAL WP.com you need a tunnel (cloudflared /
# ngrok) terminating HTTPS in front of this container — see README.
# The OAuth redirect is derived as $PUBLIC_BASE_URL/callback — register exactly
# that as the redirect URL on the WP.com app.
PUBLIC_BASE_URL=https://your-broker.example

# --- Optional --------------------------------------------------------------
# SESSION_TTL_SECONDS=300
# PORT=8080
