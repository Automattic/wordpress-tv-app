# Android (Google TV) ignores. Patterns are relative to this android/ directory.
# Standard Android Studio / Gradle ignores — expand as the project is scaffolded.

# Gradle
.gradle/
build/

# Android SDK / NDK
local.properties
.cxx/

# Build artifacts
*.apk
*.aab
captures/

# Signing / credentials — NEVER commit
*.keystore
*.jks
play-service-account.json

# Fastlane — generated reports and outputs (lanes themselves are committed)
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

# Fastlane — local secrets. NEVER commit.
fastlane/.env
fastlane/.env.local

# Bundler — gems install into vendor/bundle (see .bundle/config; config is committed).
vendor/

# Android Studio / IntelliJ
.idea/
*.iml

.kotlin/
