# frozen_string_literal: true
require 'shellwords'

default_platform(:tvos)

# Paths re-used across lanes.
PROJECT_ROOT_FOLDER = File.dirname(File.expand_path(__dir__))
XCODE_PROJECT_PATH = File.join(PROJECT_ROOT_FOLDER, 'WordPressTV.xcodeproj')

APP_SCHEME = 'WordPressTV'
APP_IDENTIFIER = 'com.automattic.wordpresstv'
SHARED_GRADLE_PROJECT_PATH = File.expand_path('../android', PROJECT_ROOT_FOLDER)

# The App Store profile name match generates — note the trailing platform suffix
# that newer match appends. Mirrors PROVISIONING_PROFILE_SPECIFIER in the project.
PROVISIONING_PROFILE_NAME = 'match AppStore com.automattic.wordpresstv tvos'

# Automattic Inc. App Store Connect account — home of the shared distribution
# certificate and the `match AppStore *` provisioning profiles.
TEAM_ID = 'PZYM8XX95Q'

# Shared Automattic `fastlane match` storage. Every a8c iOS/macOS app points at
# this same S3 bucket/region; match derives the per-team path prefix from team_id,
# which is also how it finds the existing shared distribution certificate.
# (The Apps Infra how-to that still says "Google Cloud" is stale — storage is S3 now.)
CODE_SIGNING_STORAGE_OPTIONS = {
  storage_mode: 's3',
  s3_bucket: 'a8c-fastlane-match',
  s3_region: 'us-east-2'
}.freeze

# Marketing version (CFBundleShortVersionString) from the latest git tag — e.g.
# `1.2.3` or `v1.2.3`, the leading `v` is optional — falling back to 0.0.1 when the
# repo has no tags yet. Mirrors the Android versionName (android/app/build.gradle.kts)
# so both artifacts share one source of truth: the tag. The build number
# (CFBundleVersion / CURRENT_PROJECT_VERSION) stays the CI build number.
def latest_git_tag_version
  tag = `git describe --tags --abbrev=0 2>/dev/null`.strip
  version = tag.sub(/\Av/, '')
  version.empty? ? '0.0.1' : version
end

before_all do
  # Required for `match` to work correctly on CI: creates and unlocks a dedicated
  # temporary keychain and sets it as the default, so codesign can use the imported
  # distribution private key non-interactively. Without it, match imports into the
  # login keychain, whose lock state / key partition list (ACL) makes codesign fail
  # with `errSecInternalComponent` at the CodeSign step. No-ops locally (non-CI).
  setup_ci
end

platform :tvos do
  desc 'Run the shared KMP data/domain tests'
  lane :test do
    sh("cd #{SHARED_GRADLE_PROJECT_PATH.shellescape} && ./gradlew --no-daemon --stacktrace :shared:tvosSimulatorArm64Test")
  end

  desc 'Build the WordPressTV app for the tvOS Simulator (no code signing)'
  lane :build do
    build_app(
      project: XCODE_PROJECT_PATH,
      scheme: APP_SCHEME,
      configuration: 'Debug',
      destination: 'generic/platform=tvOS Simulator',
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true
    )
  end

  desc 'Install the App Store distribution certificate + provisioning profile via match.'
  desc 'Run once with `readonly:false` to CREATE the profile for this new app; CI uses'
  desc 'the default `readonly:true` to just fetch what already exists in S3.'
  lane :configure_code_signing do |options|
    readonly = options.fetch(:readonly, true)

    match_args = {
      **CODE_SIGNING_STORAGE_OPTIONS,
      type: 'appstore',
      platform: 'tvos',
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      readonly: readonly
    }

    # Use the App Store Connect API key when present (CI); otherwise match falls back
    # to interactive Apple ID auth, which is fine for the local one-time create.
    match_args[:api_key] = app_store_connect_api_key if ENV['APP_STORE_CONNECT_API_KEY_KEY_ID']

    match(**match_args)
  end

  desc 'Build the tvOS app for distribution and upload it to TestFlight (internal testing).'
  lane :build_and_upload_to_testflight do
    api_key = app_store_connect_api_key

    # Fetch the shared distribution cert + App Store profile from S3 (read-only).
    configure_code_signing(readonly: true)

    # App Store Connect requires a unique, increasing build number per upload.
    # Use the Buildkite build number on CI; fall back to 1 for local runs.
    build_number = ENV.fetch('BUILDKITE_BUILD_NUMBER', '1')

    # Marketing version (CFBundleShortVersionString) tracks the latest git tag.
    marketing_version = latest_git_tag_version

    build_app(
      project: XCODE_PROJECT_PATH,
      scheme: APP_SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      export_team_id: TEAM_ID,
      output_directory: File.join(PROJECT_ROOT_FOLDER, 'build'),
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{marketing_version}",
      export_options: {
        method: 'app-store',
        provisioningProfiles: {
          APP_IDENTIFIER => PROVISIONING_PROFILE_NAME
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end
end
